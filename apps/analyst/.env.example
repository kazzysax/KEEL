# Keel agents (BNB Agent Studio / bnbagent). Copy to .env (analyst) and .env.grader (grader); never commit real keys.
# FULL MAINNET. For rehearsal on testnet set NETWORK=bsc-testnet and X402_NETWORK=eip155:97.
NETWORK=bsc-mainnet
WALLET_PASSWORD=
PRIVATE_KEY=0x...            # first run only, then remove (the encrypted keystore takes over)
ERC8183_AGENT_URL=http://localhost:8003/erc8183   # your public URL in production
ERC8183_SERVICE_PRICE=20000000000000000   # 0.02 U per job
ENV=production               # makes the server enforce its production checks
AGENT_ROLE=analyst           # analyst | grader  (run the grader with --env .env.grader and its own wallet and PORT)
AGENT_NAME=keel-analyst      # keel-grader for the grader
AGENT_HOST=http://localhost:8003
HOST=0.0.0.0                 # needed inside Docker
PORT=8003                    # 8004 for the grader

# Daily autonomous run (analyst)
DAILY=1
DAILY_UTC_HOUR=21.5          # after the US close

# x402 paid API: GET /daily  (analyst). The seller pays gas to settle (BNB on mainnet, cents per call).
X402=1
X402_PAY_TO=0x...            # where payments land (the analyst wallet)
X402_PRICE_U=0.005
X402_NETWORK=eip155:56       # eip155:97 for testnet
# RPC_URL=                   # optional override; use a paid RPC (NodeReal, Ankr) in production

# client/hire.py, client/propose.py (buyer side, used by the Scout)
PROVIDER_ADDRESS=0x...
GRADER_ADDRESS=0x...
ANALYST_URL=http://localhost:8003
SCOUT_AGENT_ID=
