# Keel agents (BNB Agent Studio / bnbagent). Copy to .env (analyst) and .env.grader (grader); never commit real keys.
NETWORK=bsc-testnet
WALLET_PASSWORD=
PRIVATE_KEY=0x...            # first run only, then remove (the encrypted keystore takes over)
ERC8183_AGENT_URL=http://localhost:8003/erc8183
ERC8183_SERVICE_PRICE=1000000000000000000   # 1 U per job
AGENT_ROLE=analyst           # analyst | grader  (run the grader with --env .env.grader and its own wallet and PORT)
AGENT_NAME=keel-analyst      # keel-grader for the grader
AGENT_HOST=http://localhost:8003
PORT=8003

# Daily autonomous run (analyst)
DAILY=1
DAILY_UTC_HOUR=21.5          # after the US close

# x402 paid API: GET /daily  (analyst). Off = free demo. Seller pays gas to settle: free on testnet, cents on mainnet.
X402=0
X402_PAY_TO=0x...            # where payments land (the analyst wallet)
X402_PRICE_U=0.05
X402_NETWORK=eip155:97       # eip155:56 for mainnet
# RPC_URL=                   # optional override

# client/hire.py, client/propose.py (buyer side)
PROVIDER_ADDRESS=0x...
GRADER_ADDRESS=0x...
ANALYST_URL=http://localhost:8003
SCOUT_AGENT_ID=
