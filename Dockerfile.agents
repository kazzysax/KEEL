# Keel agents (Analyst and Grader). Build from the repo root: the agents read data/prices and write public/data relative to it.
FROM python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends git openssh-client ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY apps/analyst/requirements.txt apps/analyst/requirements.txt
RUN pip install --no-cache-dir -r apps/analyst/requirements.txt
COPY . .
WORKDIR /app/apps/analyst
ENV PYTHONUNBUFFERED=1
CMD ["python", "scripts/run_agent.py"]
