# Server-only. Never prefix with NEXT_PUBLIC_
BINANCE_WEB3_API_KEY=
BINANCE_WEB3_API_SECRET=
BINANCE_WEB3_BASE=https://web3.binance.com/build
# demo mode runs without keys (mock quotes). Set to 0 once keys are present.
DEMO_MODE=1

# WalletConnect v2 (mobile wallets, QR). Free project id from cloud.reown.com (formerly WalletConnect Cloud). Without it only browser wallets work.
NEXT_PUBLIC_WC_PROJECT_ID=
